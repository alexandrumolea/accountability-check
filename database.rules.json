{
  "rules": {
    "sessions": {
      ".read": false,
      "$code": {
        ".read": true,
        "meta": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['name', 'expected', 'createdAt', 'adminKey'])"
        },
        "participants": {
          "$pid": {
            ".write": "root.child('sessions').child($code).child('meta').exists()",
            "name": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "answers": { ".validate": "newData.hasChildren()" }
          }
        }
      }
    }
  }
}
